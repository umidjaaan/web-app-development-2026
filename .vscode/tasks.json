{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Зависимости (go mod tidy)",
            "type": "shell",
            "command": "go mod tidy",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "2. Поднять PostgreSQL, Adminer и Minio",
            "type": "shell",
            "command": "docker compose -f deployments/docker-compose.yml up -d",
            "problemMatcher": []
        },
        {
            "label": "3. Создать таблицы и наполнить их",
            "type": "shell",
            "command": "go run ./cmd/migrate",
            "problemMatcher": []
        },
        {
            "label": "4. Запустить API",
            "type": "shell",
            "command": "go run ./cmd/main",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Пересоздать таблицы с нуля",
            "type": "shell",
            "command": "go run ./cmd/migrate -drop",
            "problemMatcher": []
        },
        {
            "label": "Остановить инфраструктуру",
            "type": "shell",
            "command": "docker compose -f deployments/docker-compose.yml down",
            "problemMatcher": []
        },
        {
            "label": "Форматирование (gofmt)",
            "type": "shell",
            "command": "gofmt -w ./cmd ./internal",
            "problemMatcher": []
        }
    ]
}
