{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Амфора: запуск с Minio",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main",
            "cwd": "${workspaceFolder}",
            "env": {
                "APP_ADDR": ":8080",
                "MEDIA_BASE_URL": "http://localhost:9000/rip-media"
            }
        },
        {
            "name": "Амфора: запуск без Minio (медиа из папки media)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main",
            "cwd": "${workspaceFolder}",
            "env": {
                "APP_ADDR": ":8080",
                "MEDIA_BASE_URL": "/media"
            }
        }
    ]
}
