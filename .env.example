# Пример настроек. Скопируйте в .env и при необходимости поправьте:
#   cp .env.example .env
#
# Без файла .env приложение возьмёт те же значения по умолчанию,
# поэтому с docker-compose из этого репозитория всё работает сразу.

APP_ADDR=:8080

DB_HOST=localhost
DB_PORT=5433
DB_USER=rip
DB_PASS=rip
DB_NAME=amphora

# --- Хранилище файлов MinIO -------------------------------------------
# Совпадают с deployments/docker-compose.yml
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=import-categories
# Публичный адрес бакета: из него API собирает ссылки на файлы
MEDIA_BASE_URL=http://localhost:9000/import-categories

# Текущий пользователь задаётся в коде константой через функцию-singleton
# auth.CurrentUserID (internal/app/auth/current_user.go), до ЛР4.
