# Пример настроек. Скопируйте в .env и при необходимости поправьте:
#   cp .env.example .env
#
# Без файла .env приложение возьмёт те же значения по умолчанию,
# поэтому с docker-compose из этого репозитория всё работает сразу.

APP_ADDR=:8080

DB_HOST=localhost
DB_PORT=5433
DB_USER=rip
DB_PASS=rip
DB_NAME=amphora

MEDIA_BASE_URL=http://localhost:9000/import-categories

CURRENT_USER_ID=1
