{
  "info": {
    "name": "Амфора — ЛР3 (REST API)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Веб-сервис «Амфора». Пользователь-создатель зафиксирован на бэкенде: auth.CurrentUserID() = 1."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "draft_id",
      "value": ""
    },
    {
      "key": "feed_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Основные запросы (10)",
      "item": [
        {
          "name": "1. Список услуг (фильтр по дате начала)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/import_categories?date_start=0600-01-01",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories"
              ],
              "query": [
                {
                  "key": "date_start",
                  "value": "0600-01-01"
                }
              ]
            },
            "description": "Только опубликованные. date_start — тип появился не позднее этой даты (год до н. э.). is_creator = 1 — услугу создал текущий пользователь."
          }
        },
        {
          "name": "2. Добавить услугу (фото и видео)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/import_categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories"
              ]
            },
            "description": "multipart/form-data: title, image и video — ФАЙЛЫ (выберите их во вкладке Body). Создаётся черновик; файлы уходят в MinIO под именами на латинице.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Книдские амфоры",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "JPG / PNG / WEBP"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": [],
                  "description": "MP4 / WEBM до 50 МБ"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('draft_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Получить черновик",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/import_categories/draft",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories",
                "draft"
              ]
            },
            "description": "Черновик текущего пользователя, ид не указывается."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('draft_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Опубликовать услугу",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/import_categories/{{draft_id}}/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories",
                "{{draft_id}}",
                "publish"
              ]
            },
            "description": "Черновик → опубликована. Вернуть в черновик нельзя.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date_start\": \"0250-01-01\",\n  \"date_end\": \"0050-01-01\",\n  \"description\": \"Поздняя эллинистическая тара с книдскими клеймами.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. Лента",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/import_categories/feed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories",
                "feed"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{feed_id}}",
                  "disabled": true
                },
                {
                  "key": "next",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Без параметров — первая услуга ленты. Включите id и next — следующая услуга после указанной. is_liked = 1 — текущий пользователь лайкнул услугу."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('feed_id', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Поставить лайк",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/import_categories/{{draft_id}}/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories",
                "{{draft_id}}",
                "like"
              ]
            },
            "description": "1 — поставить, 0 — отменить. Лайк ставится опубликованной услуге из шагов 2–4.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"like\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Удалить услугу",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/import_categories/{{draft_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "import_categories",
                "{{draft_id}}"
              ]
            },
            "description": "Мягкое удаление: статус deleted. Только услуги текущего пользователя."
          }
        },
        {
          "name": "8. Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"student\",\n  \"password\": \"rip2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Аутентификация (заглушка)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Заглушка до ЛР4.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"student\",\n  \"password\": \"rip2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Деавторизация (заглушка)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "logout"
              ]
            },
            "description": "Заглушка до ЛР4."
          }
        }
      ]
    },
